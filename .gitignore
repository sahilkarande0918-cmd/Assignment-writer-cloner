# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
!.env.example

# test output
/test-results
/playwright-report

# python worker
__pycache__/
*.pyc
.venv/
workers/**/.venv/
workers/**/cache/
workers/**/outputs/

# model weights / datasets never go in git
*.safetensors
*.ckpt
*.pt
*.pth
*.bin
*.onnx
/models/
/datasets/

# local claude settings
.claude/settings.local.json
/public/pdfjs/
/public/mupdf/

# handwriting worker
/workers/handwriting/models/
/workers/handwriting/*.log
/workers/handwriting/out/

# owner password (plaintext, local only)
/.owner-password

.vercel
.env*
/workers/handwriting/hf_cache/

# collage engine data: the writer's own word/letter bank and page scans are private
workers/handwriting/experiments/**/*.pkl
workers/handwriting/experiments/**/*.png
workers/handwriting/experiments/**/lines.json
