{
  "name": "assignment-writer-cloner",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "next typegen && tsc --noEmit",
    "postinstall": "node scripts/copy-assets.mjs",
    "test:live": "node --env-file=.env.local node_modules/vitest/vitest.mjs run tests/live --silent=false --disableConsoleIntercept",
    "test:int": "node --env-file=.env.test.local node_modules/vitest/vitest.mjs run tests/integration",
    "db:migrate:dev": "node --env-file=.env.test.local node_modules/drizzle-kit/bin.cjs migrate",
    "db:migrate:prod": "node --env-file=.env.local node_modules/drizzle-kit/bin.cjs migrate"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1161.0",
    "@aws-sdk/s3-request-presigner": "^3.1161.0",
    "@neondatabase/serverless": "^1.2.0",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-switch": "^1.4.1",
    "@react-three/fiber": "^9.8.2",
    "clsx": "^2.1.1",
    "docx-preview": "^0.4.1",
    "drizzle-orm": "^0.45.4",
    "groq-sdk": "^1.6.0",
    "jszip": "^3.10.2",
    "lucide-react": "^1.66.0",
    "motion": "^14.9.0",
    "mupdf": "^1.28.1",
    "next": "16.4.3",
    "pdfjs-dist": "^6.4.299",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "^3.7.0",
    "tesseract.js": "^7.0.0",
    "three": "^0.187.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.1.2",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
