# Copy to .env.local (never commit real values). All secrets are server-only: no NEXT_PUBLIC_ prefix.

# --- Groq (only AI provider) — https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_REASONING_MODEL=openai/gpt-oss-120b
GROQ_VISION_MODEL=qwen/qwen3.8-27b

# --- Neon (project "Assignment cloner"). Fill with:  neon env pull -s postgres -s object-storage -s data-api
NEON_PROJECT_ID=
NEON_BRANCH=
DATABASE_URL=            # pooled — app/serverless
DATABASE_URL_UNPOOLED=   # direct — migrations
NEON_DATA_API_URL=

# --- Neon Object Storage (S3-compatible, private bucket, path-style, SigV4)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=us-east-2
STORAGE_BUCKET=assignment-files
# On Vercel the AWS_* names are reserved: set the same values as S3_ENDPOINT, S3_REGION, S3_ACCESS_KEY_ID, S3_SECRET_ACCESS_KEY.

# --- Accounts (Neon Auth; enable with: neon neon-auth enable --branch <branch>)
NEON_AUTH_BASE_URL=        # printed by `neon neon-auth enable`
NEON_AUTH_COOKIE_SECRET=   # 32+ random characters
OWNER_EMAIL=sahilkarande0918@gmail.com   # verified account with unlimited generations; everyone else gets 3

# --- GPU worker (outbound polling only). Same value on the server and in the worker.
WORKER_TOKEN=
# Cloud GPU, free (Kaggle: phone-verified account, Settings -> API -> create token). Generate starts a private
# Kaggle GPU run of the worker. Either the new single token or the legacy username+key pair.
KAGGLE_USERNAME=
KAGGLE_API_TOKEN=
KAGGLE_KEY=
# Cloud GPU, paid alternative (Modal; needs a payment method): the `trigger` URL printed by `modal deploy`.
GPU_TRIGGER_URL=
# Local worker only (set in the worker's shell, or use workers/handwriting/run-worker.ps1):
# HW_API_URL=http://localhost:3000
# HW_WORKER_TOKEN=<same as WORKER_TOKEN>
# HW_MODEL_DIR=workers/handwriting/models
