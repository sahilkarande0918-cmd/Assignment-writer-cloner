# Copy to .env.local (never commit real values). All secrets are server-only: no NEXT_PUBLIC_ prefix.

# --- Groq (only AI provider) — https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_REASONING_MODEL=openai/gpt-oss-120b
GROQ_VISION_MODEL=qwen/qwen3.8-27b

# --- Neon Postgres (cloud persistence; optional — without it projects stay in browser IndexedDB)
DATABASE_URL=

# --- S3-compatible private object storage (Neon Object Storage when available)
STORAGE_ENDPOINT=
STORAGE_REGION=auto
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

# --- Single-owner auth
OWNER_PASSWORD_HASH=
SESSION_SECRET=

# --- Local GPU worker (outbound polling only). Same value on the server and in the worker.
WORKER_TOKEN=
# Worker-side only (set in the worker's shell, or use workers/handwriting/run-worker.ps1):
# HW_API_URL=http://localhost:3000
# HW_WORKER_TOKEN=<same as WORKER_TOKEN>
# HW_MODEL_DIR=workers/handwriting/models
